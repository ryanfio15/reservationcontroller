<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The composition root: endpoint groups, auth handlers, the Blazor host and /auth/*.
    It is the only project allowed to reference both the server modules and the UI, which is
    why nothing else may reference it.
  -->

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>reservationcontroller-web</UserSecretsId>
    <DockerfileContext>../..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Domain/Domain.csproj" />
    <ProjectReference Include="../Infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="../Web.Client/Web.Client.csproj" />
  </ItemGroup>

</Project>
